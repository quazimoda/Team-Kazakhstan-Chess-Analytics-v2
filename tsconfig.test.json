{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "types": ["node"],
    "incremental": false
  },
  "include": ["src/**/*.test.ts", "src/lib/analytics/**/*.ts"],
  "exclude": ["node_modules", ".next", ".test-build"]
}
